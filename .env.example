# Copy to .env for docker compose (docs/self-hosting.md). Never commit .env.

# Required
POSTGRES_PASSWORD=change-me-to-a-long-random-string
APP_URL=https://lintel.your-firm.com

# Where this server stores data, shown to every firm it hosts (e.g. eu-west, us-east, on-premises)
LINTEL_REGION=on-premises

# Assistant chat (optional; checks, fixes and approvals work without it)
ANTHROPIC_API_KEY=

# Email for invites and password resets (optional; links are shown in the app without it)
RESEND_API_KEY=
MAIL_FROM=Lintel <lintel@your-firm.com>

# Staff tools: setting plans, seats and assistant limits per firm (PATCH /api/staff/firms/<id>)
LINTEL_STAFF_TOKEN=
